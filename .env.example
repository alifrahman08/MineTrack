# MineTrack Environment Configuration

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Supabase Authentication & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Application Security & Signed URLs
JWT_SECRET="minetrack-production-super-secret-jwt-key-2026-very-secure"
STORAGE_SIGNING_SECRET="minetrack-storage-hmac-sha256-signing-secret-2026"
NODE_ENV="development"

# Integrations Architecture Prerequisites (Contracts Ready - Configure when Hardware is Deployed)
# 1. Weighbridge Scale Indicator (RS-232 / TCP Socket Bridge)
SCALE_INDICATOR_HOST="192.168.10.50"
SCALE_INDICATOR_PORT="4001"
SCALE_INDICATOR_PROTOCOL="TOLEDO_8142"

# 2. GPS / Telemetry Telematics Gateway (MQTT / REST)
TELEMETRY_ENDPOINT="https://telemetry-gateway.mine-site.internal/api/v1/feed"
TELEMETRY_API_KEY="sk_telemetry_2026_demo"

# 3. Fleet Dispatch System (FMS)
DISPATCH_API_ENDPOINT="https://dispatch-fms.mine-site.internal/api/v2"
DISPATCH_API_KEY="sk_fms_dispatch_2026_demo"

# 4. Enterprise ERP (SAP / Oracle / Custom OData)
ERP_API_BASE_URL="https://erp.corporate-mining.internal/api/v1"
ERP_CLIENT_ID="minetrack_erp_client"
ERP_CLIENT_SECRET="minetrack_erp_secret_2026"
